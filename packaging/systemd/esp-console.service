[Unit]
Description=ESP authenticated machine console
Wants=network-online.target
After=network-online.target systemd-modules-load.service
Before=display-manager.service getty.target
ConditionPathExists=/var/lib/esp-console/network.yml

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=30
User=root
Group=root
Environment=RUST_LOG=esp=info
EnvironmentFile=/etc/esp/console.env
ExecStart=/usr/local/bin/esp video serve --config /var/lib/esp-console/network.yml --peer ${ESP_CONSOLE_PEER} --source ${ESP_CONSOLE_SOURCE} --size ${ESP_CONSOLE_SIZE}
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
StateDirectory=esp-console
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# GPU framebuffer export requires SYS_ADMIN; fbcon mapping may require SYS_TTY_CONFIG.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_TTY_CONFIG CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/esp-console
# Device nodes and real VTs must remain visible. Do not enable PrivateDevices.

[Install]
WantedBy=multi-user.target
